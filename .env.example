# =============================================================================
# SAHARYN AI — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in your real values.
# On Railway: go to your service → Variables tab → paste each key.
# =============================================================================


# ─────────────────────────────────────────────────────────────
# CORE SECURITY (REQUIRED — app crashes without these)
# ─────────────────────────────────────────────────────────────

SAHARYN_API_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-here
SAHARYN_ENV=PRODUCTION

# SIMULATION = instant fake data, no external calls (set this while fixing API keys)
# LIVE = uses real NASA/ESA/Copernicus APIs
SAHARYN_SATELLITE_MODE=SIMULATION


# ─────────────────────────────────────────────────────────────
# NASA EARTHDATA — MODIS Aerosol Data (AOD)
# Website: https://urs.earthdata.nasa.gov
# Steps: Register → Login → Generate Token (expires every 60 days!)
# ─────────────────────────────────────────────────────────────
EARTHDATA_TOKEN=your-nasa-earthdata-token-here


# ─────────────────────────────────────────────────────────────
# COPERNICUS CDS — ERA5 Weather Data
# Website: https://cds.climate.copernicus.eu
# Steps: Register → Login → Your Profile → API Key section
# ─────────────────────────────────────────────────────────────
ECMWF_API_KEY=your-ecmwf-cds-api-key-here
ECMWF_API_URL=https://cds.climate.copernicus.eu/api


# ─────────────────────────────────────────────────────────────
# COPERNICUS ADS — CAMS Dust/Aerosol Forecast
# Website: https://ads.atmosphere.copernicus.eu  (DIFFERENT from CDS!)
# Steps: Separate registration → Login → Your Profile → API Key
# ─────────────────────────────────────────────────────────────
COP_API_KEY=your-copernicus-ads-api-key-here
COP_API_URL=https://ads.atmosphere.copernicus.eu/api


# ─────────────────────────────────────────────────────────────
# SENTINEL HUB — Sentinel-2 Dust Plume Detection
# Website: https://shapps.dataspace.copernicus.eu
# Steps: Register at dataspace.copernicus.eu → Login →
#        User Settings → OAuth Clients → Create client → copy ID + Secret
#        Instance ID: Configuration Utility → your config → copy ID
# ─────────────────────────────────────────────────────────────
SENTINELHUB_CLIENT_ID=your-sentinel-hub-client-id
SENTINELHUB_CLIENT_SECRET=your-sentinel-hub-client-secret
SENTINELHUB_INSTANCE_ID=your-sentinel-hub-instance-id


# ─────────────────────────────────────────────────────────────
# GOOGLE EARTH ENGINE — MODIS via GEE
# Website: https://earthengine.google.com
# Steps: Sign Up → get approved → create Google Cloud project →
#        enable Earth Engine API → set project ID below
# ─────────────────────────────────────────────────────────────
GEE_PROJECT=your-google-cloud-project-id


# ─────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────
# Railway auto-injects DATABASE_URL if you add a Postgres plugin
DATABASE_URL=postgresql://user:password@host:5432/saharyn_prod
DB_USER=saharyn_admin
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saharyn_prod


# ─────────────────────────────────────────────────────────────
# FIREBASE — Backend Service Account (for token verification)
# Website: https://console.firebase.google.com
# Steps: Open saharyn-ai project → Project Settings →
#        Service Accounts → Generate new private key → paste JSON below
# ─────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"saharyn-ai",...}


# ─────────────────────────────────────────────────────────────
# MLOPS — MLflow Tracking (optional for local dev)
# Website: https://dagshub.com (free hosted) or self-host
# ─────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000


# ─────────────────────────────────────────────────────────────
# SCADA / PI SYSTEM (Enterprise only — skip for now)
# Website: Your internal AVEVA PI Server
# ─────────────────────────────────────────────────────────────
PI_WEBAPI_URL=https://pi-server.yourcompany.com/piwebapi
PI_USERNAME=service-account-readonly
PI_PASSWORD=your-pi-password


# ─────────────────────────────────────────────────────────────
# SIEM SECURITY LOGGING (all optional)
# ─────────────────────────────────────────────────────────────
SPLUNK_HEC_URL=https://your-splunk.com:8088/services/collector
SPLUNK_HEC_TOKEN=your-splunk-hec-token
ELK_ELASTICSEARCH_URL=https://your-elastic.es.io:9243
ELK_API_KEY=your-elastic-api-key
AZURE_SENTINEL_URL=https://ods.opinsights.azure.com/...
AZURE_SENTINEL_KEY=your-azure-sentinel-key
